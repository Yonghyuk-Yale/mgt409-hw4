# Copy this file to .env (in this folder or in backend/) and fill in the values.
# .env is git-ignored; never commit real keys.

# Required for the chat assistant (Portkey gateway). Without it the shop and accounts
# still work and the chat answers "offline".
PORTKEY_API_KEY=

# Optional — model used through Portkey (default: gpt-6-luna)
# PORTKEY_MODEL=gpt-6-luna

# Optional — secret that signs login cookies. If unset, a random one is made at start-up
# (still secure, but everyone is logged out when the server restarts).
# SESSION_SECRET=

# Optional — set to 1 only when the site is served over HTTPS
# COOKIE_SECURE=1
